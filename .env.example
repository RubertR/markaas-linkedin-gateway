# Unipile — één DSN voor alle omgevingen (v1 kent geen aparte apps).
# UNIPILE_API_KEY: het Access Token van deze omgeving (lokaal je ontwikkel-token;
# op Railway een eigen langlevend token, bijv. "gateway-railway").
UNIPILE_DSN=api0.unipile.com:0000
UNIPILE_API_KEY=

# Webhooks
WEBHOOK_SECRET=

# MCP-server — bearer-token voor Streamable HTTP op /mcp (SPEC §7)
MCP_TOKEN=

# Goedkeuringspagina (SPEC §12). Maak een nieuwe hash met: npm run admin:hash
ADMIN_PASSWORD_HASH=

# Database — Supabase, Frankfurt (eu-central-1), project uujvmoqsalpgshptiljy
DATABASE_URL=

# HTTP-server. Railway zet PORT zelf; lokaal standaard 3000.
PORT=3000

# Publieke basis-URL voor de notify_url in koppellinks, de koppelpagina's (/koppelen/<token>)
# en de terugkeerpagina's na Unipile (zonder slash aan het eind).
# Leeg = Railway's RAILWAY_PUBLIC_DOMAIN, anders http://localhost:PORT.
PUBLIC_BASE_URL=

# Planner-lus (verwerkt goedgekeurde acties en sequentie-stappen). Alleen "true" zet hem aan.
PLANNER_ENABLED=false

# Logging (debug|info|warn|error)
LOG_LEVEL=info

# Standaard-tijdzone voor accounts als er geen bekend is
TIMEZONE_DEFAULT=Europe/Amsterdam

# Omgeving (development|production)
NODE_ENV=development

# Stripe — abonnement en betalen (SPEC §14.4). Optioneel: zolang niet alle drie gezet zijn,
# staat betalen "uit" en tonen portaal en admin "Betalen is nog niet ingericht".
# Begin in testmodus: sk_test_… en de whsec_… van het test-webhook-endpoint.
# STRIPE_SECRET_KEY: Developers → API keys → Secret key (of een restricted key).
STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET: signing secret van het endpoint https://<domein>/webhooks/stripe.
STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID: de maandprijs van het product (price_…).
STRIPE_PRICE_ID=
